# Copy to .env and fill in whatever keys you have.
# Providers without keys are skipped (or use --include-mock).

# Amadeus Self-Service (best free live pricing)
# Sign up: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test | production  (test uses sandbox data)
AMADEUS_ENV=test

# Travelpayouts / Aviasales cached prices (free after signup)
# Sign up: https://www.travelpayouts.com/ → Profile → API token
TRAVELPAYOUTS_TOKEN=

# Duffel (modern flights API — free sandbox)
# Sign up: https://duffel.com/
DUFFEL_ACCESS_TOKEN=

# SerpAPI Google Flights scrape (has free monthly quota)
# Sign up: https://serpapi.com/
SERPAPI_KEY=

# AviationStack (schedules/status — free ~100/mo)
# Sign up: https://aviationstack.com/
AVIATIONSTACK_KEY=

# xAI / Grok — natural language search + result analysis
# Sign up: https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Default display currency (Escape + Detour; set in Settings UI)
DEFAULT_CURRENCY=USD

# Never use these as adventure stopovers (ISO2, max 10)
# AVOID_COUNTRIES=US,RU,CN

# smart = probe active keys + budget routing | scan_all = every configured key
PROVIDER_MODE=smart

# true = show "Test Data" (mock fares) on Escape/Detour · false = live only
TESTING=false

# Detour defaults (also editable in Settings → Detour defaults)
DETOUR_MIN_STOP_DAYS=3
DETOUR_MAX_STOP_DAYS=5
DETOUR_MAX_CANDIDATES=5

# Visited stamps (ISO2) — optional seed; also editable on the passport map in the UI
# VISITED_COUNTRIES=CA,JP,MX

# PROVIDER_MODE notes: empty Travelpayouts token is ignored; only probed-healthy APIs are used
# Modes: Escape = plain-English A→B · Detour = stopovers/getaways (both require a vibe)
