modules = ["python-3.11", "web", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["chromium", "gitFull", "libxcrypt", "playwright-driver"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
DEFAULT_CURRENCY = "USD"
PROVIDER_MODE = "smart"
XAI_MODEL = "grok-4.5"
DETOUR_MAX_CANDIDATES = "5"
SEARCH_BUDGET_SECONDS = "25"
SEARCH_MAX_SECONDS = "32"
CODE_PROMO = "YONDERCITY"
LINK_PROMO = "https://go.getproton.me/aff_c?offer_id=26&aff_id=1204"
YONDER_DISABLE_RECYCLE = "1"
SAVED_TRIP_LIMIT = "8"

[userenv.production]
TESTING = "false"

[userenv.development]
TESTING = "true"

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn yonder.web:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "test-shard-1"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_test_shard.py --shard 1"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-shard-2"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_test_shard.py --shard 2"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-shard-3"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_test_shard.py --shard 3"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-shard-4"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_test_shard.py --shard 4"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-shard-5"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_test_shard.py --shard 5"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-shard-6"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_test_shard.py --shard 6"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5091
externalPort = 3001

[[ports]]
localPort = 5092
externalPort = 3002

[[ports]]
localPort = 23636
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "-w=4", "--timeout=180", "--graceful-timeout=90", "-k=uvicorn.workers.UvicornWorker", "yonder.web:app"]
