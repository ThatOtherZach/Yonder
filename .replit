modules = ["python-3.11", "web", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
DEFAULT_CURRENCY = "USD"
PROVIDER_MODE = "smart"
XAI_MODEL = "grok-4.5"
DETOUR_MAX_CANDIDATES = "5"
SEARCH_BUDGET_SECONDS = "30.0"
SEARCH_MAX_SECONDS = "42.0"
CODE_PROMO = "YONDERCITY"
LINK_PROMO = "https://go.getproton.me/aff_c?offer_id=26&aff_id=1204"
YONDER_DISABLE_RECYCLE = "1"
SAVED_TRIP_LIMIT = "8"

[userenv.production]
TESTING = "false"

[userenv.development]
TESTING = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn yonder.web:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5091
externalPort = 3001

[[ports]]
localPort = 5092
externalPort = 3002

[[ports]]
localPort = 23636
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "-w=4", "-k=uvicorn.workers.UvicornWorker", "yonder.web:app"]
